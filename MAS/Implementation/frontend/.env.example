# Base URL of the Restaurant Management and Ordering API (ASP.NET Core backend).
# Example: http://localhost:5229
VITE_API_BASE_URL=http://localhost:5229

# Identifier of the customer whose order is being created (demo configuration;
# the backend has no authentication). Seeded customers:
#   1 = Alice Smith   (loyalty card LOYAL-1001, active)
#   2 = Bob Johnson   (no loyalty card)
#   3 = Charlie Brown (expired card LOYAL-2002)
VITE_CUSTOMER_ID=1